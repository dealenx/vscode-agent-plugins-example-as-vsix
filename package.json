{
  "name": "vscode-agent-plugins-example-as-vsix",
  "displayName": "Agent Plugins Example as VSIX",
  "description": "Installs/uninstalls itself as a VS Code Agent Plugin (experimental).",
  "version": "0.0.1",
  "publisher": "dealenx",
  "license": "MIT",
  "engines": { "vscode": "^1.110.0" },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "repository": "github:dealenx/vscode-agent-plugins-example-as-vsix",
  "contributes": {
    "commands": [
      { "command": "agentPluginInstaller.install", "title": "Agent Plugin: Install this extension as plugin" },
      { "command": "agentPluginInstaller.uninstall", "title": "Agent Plugin: Uninstall this extension as plugin" }
    ]
  },
  "scripts": { "package": "vsce package --no-dependencies --allow-missing-repository" }
}